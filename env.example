# Codex Reset Watch environment template
#
# For beginners:
#   1. Duplicate this visible file.
#   2. Rename the copy to `env` or `.env`.
#      `env` is easier to see in Finder; `.env` is the standard developer name.
#   3. Replace only TWITTERAPI_IO_KEY.
#   4. Keep the real key private. The local `env` and `.env` files are ignored by git.

# =============================================================================
# Required settings
# =============================================================================

# Target X/Twitter account.
TARGET_X_HANDLE=thsottiaux

# Paste your TwitterAPI.io key here.
# Example:
#   TWITTERAPI_IO_KEY=tapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITTERAPI_IO_KEY=PASTE_YOUR_TWITTERAPI_IO_KEY_HERE

# =============================================================================
# Recommended defaults
# =============================================================================

# Store long-term state outside the repo so Automation remembers what it has
# already reported even if the repo/worktree is refreshed.
STATE_FILE_PATH=~/.cache/codex-reset-watch/state.json

# Reset announcements can be replies, not only top-level tweets.
INCLUDE_REPLIES=true

# Fetch thread context for replies such as "yes, later today" so the checker can
# see the parent question about Codex usage/quota/rate-limit resets.
HYDRATE_REPLY_CONTEXT=true
HYDRATE_REPLY_CONTEXT_MODE=all

# Keep each run modest. Increase only if the target account becomes very active.
CHECK_ONCE_MAX_PAGES=2
THREAD_CONTEXT_MAX_FETCHES=12
THREAD_CONTEXT_MAX_PAGES=1
THREAD_CONTEXT_MAX_TWEETS=8
THREAD_CONTEXT_MAX_CHARS=2400

# Retry transient TwitterAPI.io DNS/network failures inside the same run. If the
# host is still unreachable, the script exits cleanly with structured JSON so the
# Automation can avoid noisy one-off operational findings.
TWITTERAPI_IO_RETRY_ATTEMPTS=3
TWITTERAPI_IO_RETRY_SLEEP_SECONDS=5
TWITTERAPI_IO_RETRY_MAX_SLEEP_SECONDS=30
TRANSIENT_NETWORK_ERRORS_EXIT_ZERO=true
OPERATIONAL_ERROR_REPORT_THRESHOLD=3

# Hybrid detection: rules handle high-confidence matches; Codex Automation's LLM
# reviews ambiguous medium/low-confidence candidates in the same run.
RULES_AUTO_ALERT_CONFIDENCES=high
CODEX_LLM_REVIEW_ENABLED=true
CODEX_LLM_REVIEW_CONFIDENCES=medium,low
CODEX_LLM_REVIEW_MIN_SCORE=5
CODEX_LLM_REVIEW_REQUIRE_REPLY_CONTEXT=true

# Prevent duplicate findings for the same tweet/thread while still allowing a
# later "reset complete" phase update.
EVENT_DEDUPE_ENABLED=true
EVENT_DEDUPE_WINDOW_HOURS=24
EVENT_DEDUPE_ALLOW_PHASE_UPDATES=true

# First run safety: old tweets are used as a baseline and are not reported.
ALERT_ON_FIRST_RUN=false

# Optional: if you know the stable X/Twitter user ID, fill it in. Otherwise leave blank.
TARGET_X_USER_ID=
