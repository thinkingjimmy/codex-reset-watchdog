# Codex Reset Watchdog environment template
#
# For beginners:
#   1. Duplicate this visible file.
#   2. Rename the copy to `env` or `.env`.
#      `env` is easier to see in Finder; `.env` is the standard developer name.
#   3. Keep the defaults unless you want to monitor another public Dayclaw source.
#   4. There is no API key. The checked endpoint is public.

# =============================================================================
# Public source
# =============================================================================

# Target X/Twitter account. The runtime builds:
# https://api.dayclaw.com/api/source/public/x/<handle>/items
TARGET_X_HANDLE=thsottiaux

# Optional hard override. Leave blank to derive the URL from TARGET_X_HANDLE.
DAYCLAW_SOURCE_ITEMS_URL=

# =============================================================================
# Runtime state
# =============================================================================

# Store state inside this project folder so Codex sandboxed runs can write it.
# The var/ folder is ignored by git.
STATE_FILE_PATH=var/state.json

# Reset announcements can be replies, not only top-level tweets. The current
# Dayclaw public feed exposes reply metadata when available, but does not expose
# parent-thread hydration.
INCLUDE_REPLIES=true

# Retry transient Dayclaw DNS/network failures inside the same run. If the host
# is still unreachable, the script exits cleanly with structured JSON so the
# Automation can avoid noisy one-off operational findings.
DAYCLAW_RETRY_ATTEMPTS=3
DAYCLAW_RETRY_SLEEP_SECONDS=5
DAYCLAW_RETRY_MAX_SLEEP_SECONDS=30
TRANSIENT_NETWORK_ERRORS_EXIT_ZERO=true
OPERATIONAL_ERROR_REPORT_THRESHOLD=3
OPERATIONAL_ERROR_REPORT_EVERY_FAILURES=24

# LLM-first detection: the script emits every new unseen public source item to
# Codex Automation. The Automation LLM decides whether a reset finding should be posted.

# First run safety: old items are used as a baseline and are not reported.
ALERT_ON_FIRST_RUN=false
